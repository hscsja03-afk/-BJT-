# Logical RGB follows PANEL FPC pin positions, not custom PCB net suffixes.
# FPC3..10=R0..7,12..19=G0..7,21..28=B0..7; PCB/TEL/core2V5 audited.
# FPC1.3 -> X2.58 -> X4.43: B34_L18_N      LCD_R1
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[16]}]
# FPC1.4 -> X2.56 -> X4.45: B34_L18_P      LCD_R0
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[17]}]
# FPC1.5 -> X2.55 -> X4.46: B34_L5_P       LCD_R2
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[18]}]
# FPC1.6 -> X2.57 -> X4.44: B34_L5_N       LCD_R3
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[19]}]
# FPC1.7 -> X2.64 -> X4.37: B34_L7_P      LCD_R5
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[20]}]
# FPC1.8 -> X2.62 -> X4.39: B34_L7_N      LCD_R4
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[21]}]
# FPC1.9 -> X2.59 -> X4.42: B34_L9_P       LCD_R6
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[22]}]
# FPC1.10 -> X2.61 -> X4.40: B34_L9_N       LCD_R7
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[23]}]
# FPC1.12 -> X2.68 -> X4.33: B34_L21_N     LCD_G1
set_property -dict {PACKAGE_PIN V18 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[8]}]
# FPC1.13 -> X2.66 -> X4.35: B34_L21_P     LCD_G0
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[9]}]
# FPC1.14 -> X2.63 -> X4.38: B34_L20_P       LCD_G2
set_property -dict {PACKAGE_PIN T17 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[10]}]
# FPC1.15 -> X2.65 -> X4.36: B34_L20_N       LCD_G3
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[11]}]
# FPC1.16 -> X2.72 -> X4.29: B34_L17_N     LCD_G5
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[12]}]
# FPC1.17 -> X2.70 -> X4.31: B34_L17_P     LCD_G4
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[13]}]
# FPC1.18 -> X2.69 -> X4.32: B34_L24_P       LCD_G6
set_property -dict {PACKAGE_PIN P15 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[14]}]
# FPC1.19 -> X2.71 -> X4.30: B34_L24_N       LCD_G7
set_property -dict {PACKAGE_PIN P16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[15]}]
# FPC1.21 -> X2.76 -> X4.25: B34_L22_N     LCD_B1
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[0]}]
# FPC1.22 -> X2.74 -> X4.27: B34_L22_P     LCD_B0
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[1]}]
# FPC1.23 -> X2.73 -> X4.28: B34_L19_P       LCD_B2
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[2]}]
# FPC1.24 -> X2.75 -> X4.26: B34_L19_N       LCD_B3
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[3]}]
# FPC1.25 -> X2.80 -> X4.21: B34_L16_P     LCD_B5
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[4]}]
# FPC1.26 -> X2.78 -> X4.23: B34_L16_N     LCD_B4
set_property -dict {PACKAGE_PIN W20 IOSTANDARD LVCMOS33} [get_ports {lcd_rgb[5]}]
# FPC1.27 -> X2.79 -> X4.22: B34_L23_N       LCD_B6
